# Environment of the pipeline on Trillium (sourced by trillium-setup.sh and trillium-job.sh)
module load python/3.12 >/dev/null 2>&1
module load arrow/21.0.0 >/dev/null 2>&1          # pyarrow (Alliance module, not pip)
export PATH=$SCRATCH/ollama/bin:$PATH
export OLLAMA_MODELS=$SCRATCH/ollama/models         # jobs cannot write to $HOME
export HF_HOME=$SCRATCH/hf-cache
export PROFILE=full
